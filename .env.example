# Copia este archivo a .env y rellénalo. El .env nunca se sube a Git.

# Servicio de música (src/server/providers/<nombre>.js). De momento: spotify
MUSIC_PROVIDER=spotify

# Opcional. App compartida de BeatPlay (https://developer.spotify.com/dashboard).
# En Development Mode solo la pueden usar 5 cuentas autorizadas: el resto de usuarios
# entra con su propia app (su Client ID) desde la guía de la pantalla de login.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Obligatoria. La que cada usuario pondrá en su app (la guía la muestra para copiarla).
# En local Spotify exige la IP de loopback (no acepta "localhost"):
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback
# En producción (Render): https://TU-APP.onrender.com/callback

# Opcional. Playlist de la "Selección oficial" de Hipster.
HIPSTER_PLAYLIST_ID=

# Opcional. Clave para cifrar la sesión en la cookie (cualquier texto largo y aleatorio).
# Si no está, se usa SPOTIFY_CLIENT_SECRET; así un reinicio no echa a nadie.
SESSION_SECRET=

# Opcional. Carpeta de datos (caché de la Selección oficial de Hipster). Por defecto ./data.
DATA_DIR=

# Opcional. Por defecto 3000 (Render lo define solo).
PORT=3000
